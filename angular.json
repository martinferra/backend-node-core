{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
      "mean-core": {
        "root": "",
        "sourceRoot": "src",
        "projectType": "application",
        "architect": {
          "build": {
            "builder": "@angular-builders/custom-webpack:browser",
            "options": {
              "outputPath": "dist/mean-core",
              "index": "src/index.html",
              "main": "src/main.ts",
              "tsConfig": "./tsconfig.app.json",
              "polyfills": "src/polyfills.ts",
              "assets": [
                "src/assets",
                "src/favicon.ico",
                "src/manifest.webmanifest",
                "src/.well-known"
              ],
              "styles": [
                "src/styles.scss"
              ],
              "aot": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "buildOptimizer": false,
              "sourceMap": true,
              "optimization": false,
              "namedChunks": true,
              "serviceWorker": true,
              "ngswConfigPath": "ngsw-config.json",
              "customWebpackConfig": {
                "path": "./webpack.config.js"
              },
              "allowedCommonJsDependencies": [
                "lodash",
                "file-saver",
                "moment"
              ]
            },
            "configurations": {
              "production": {
                "optimization": true,
                "outputHashing": "all",
                "sourceMap": false,
                "namedChunks": false,
                "aot": true,
                "extractLicenses": true,
                "vendorChunk": false,
                "buildOptimizer": true,
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.prod.ts"
                  }
                ]
              },
              "production-debug": {
                "optimization": true,
                "outputHashing": "all",
                "sourceMap": true,
                "namedChunks": false,
                "aot": true,
                "extractLicenses": true,
                "vendorChunk": false,
                "buildOptimizer": true,
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.prod.ts"
                  }
                ]
              },
              "development": {
                "optimization": false,
                "outputHashing": "none",
                "sourceMap": true,
                "namedChunks": true,
                "aot": false,
                "extractLicenses": false,
                "vendorChunk": true,
                "buildOptimizer": false,
                "fileReplacements": []
              }
            }
          },
          "serve": {
            "builder": "@angular-builders/custom-webpack:dev-server",
            "options": {
              "browserTarget": "mean-core:build",
              "customWebpackConfig": {
                "path": "./webpack.config.js"
              }
            },
            "configurations": {
              "production": {
                "browserTarget": "mean-core:build:production"
              }
            }
          },
          "extract-i18n": {
            "builder": "@angular-devkit/build-angular:extract-i18n",
            "options": {
              "browserTarget": "mean-core:build"
            }
          }
        }
      },
      "@martinferra/frontend-common": {
        "projectType": "library",
        "root": "projects/martinferra/frontend-common",
        "sourceRoot": "projects/martinferra/frontend-common/src",
        "prefix": "lib",
        "architect": {
          "build": {
            "builder": "@angular-devkit/build-angular:ng-packagr",
            "options": {
              "project": "projects/martinferra/frontend-common/ng-package.json"
            },
            "configurations": {
              "production": {
                "tsConfig": "projects/martinferra/frontend-common/tsconfig.lib.prod.json"
              },
              "development": {
                "tsConfig": "projects/martinferra/frontend-common/tsconfig.lib.json"
              }
            },
            "defaultConfiguration": "production"
          },
          "test": {
            "builder": "@angular/build:karma",
            "options": {
              "tsConfig": "projects/martinferra/frontend-common/tsconfig.spec.json",
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          }
        }
      },
      "@martinferra/frontend-custom": {
        "projectType": "library",
        "root": "../frontend-custom",
        "sourceRoot": "../frontend-custom/src",
        "prefix": "lib",
        "architect": {
          "build": {
            "builder": "@angular-devkit/build-angular:ng-packagr",
            "options": {
              "project": "../frontend-custom/ng-package.json"
            },
            "configurations": {
              "production": {
                "tsConfig": "../frontend-custom/tsconfig.lib.prod.json"
              },
              "development": {
                "tsConfig": "../frontend-custom/tsconfig.lib.json"
              }
            },
            "defaultConfiguration": "production"
          },
          "test": {
            "builder": "@angular/build:karma",
            "options": {
              "tsConfig": "../frontend-custom/tsconfig.spec.json",
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          }
        }
      }
    },
    "schematics": {
      "@schematics/angular:component": {
        "prefix": "app",
        "style": "scss"
      },
      "@schematics/angular:directive": {
        "prefix": "app"
      }
    },
    "cli": {
      "analytics": false
    }
  }
